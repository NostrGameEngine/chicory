<?xml version="1.0" encoding="UTF-8"?>
<project xmlns="http://maven.apache.org/POM/4.0.0" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 http://maven.apache.org/xsd/maven-4.0.0.xsd">
  <modelVersion>4.0.0</modelVersion>

  <parent>
    <groupId>org.ngengine.chicory</groupId>
    <artifactId>chicory</artifactId>
    <version>999-SNAPSHOT</version>
    <relativePath>../pom.xml</relativePath>
  </parent>
  <artifactId>teavm-tests</artifactId>
  <name>Chicory - NGE TeaVM Runtime Tests</name>
  <description>Compile and execute the interpreter with the NGE TeaVM fork</description>

  <properties>
    <!-- Match the fork's ASM dependency within this test module. -->
    <asm.version>9.10.1</asm.version>
    <teavm.version>0.16.0-SNAPSHOT</teavm.version>
    <maven.deploy.skip>true</maven.deploy.skip>
    <maven.install.skip>true</maven.install.skip>
  </properties>

  <dependencies>
    <dependency>
      <groupId>org.ngengine.chicory</groupId>
      <artifactId>runtime</artifactId>
    </dependency>
    <dependency>
      <groupId>org.ngengine.chicory</groupId>
      <artifactId>wasm</artifactId>
    </dependency>
    <dependency>
      <groupId>org.ngengine</groupId>
      <artifactId>teavm-classlib</artifactId>
      <version>${teavm.version}</version>
      <scope>provided</scope>
    </dependency>
  </dependencies>

  <repositories>
    <repository>
      <releases>
        <enabled>false</enabled>
      </releases>
      <snapshots>
        <enabled>true</enabled>
      </snapshots>
      <id>nge-teavm-snapshots</id>
      <url>https://central.sonatype.com/repository/maven-snapshots/</url>
    </repository>
  </repositories>
  <pluginRepositories>
    <pluginRepository>
      <releases>
        <enabled>false</enabled>
      </releases>
      <snapshots>
        <enabled>true</enabled>
      </snapshots>
      <id>nge-teavm-snapshots</id>
      <url>https://central.sonatype.com/repository/maven-snapshots/</url>
    </pluginRepository>
  </pluginRepositories>

  <build>
    <plugins>
      <plugin>
        <groupId>org.apache.maven.plugins</groupId>
        <artifactId>maven-dependency-plugin</artifactId>
        <configuration>
          <ignoredUnusedDeclaredDependencies combine.children="append">
            <dependency>org.ngengine:teavm-classlib</dependency>
          </ignoredUnusedDeclaredDependencies>
        </configuration>
      </plugin>
      <plugin>
        <groupId>org.codehaus.mojo</groupId>
        <artifactId>exec-maven-plugin</artifactId>
        <executions>
          <execution>
            <id>execute-javascript</id>
            <goals>
              <goal>exec</goal>
            </goals>
            <phase>integration-test</phase>
            <configuration>
              <executable>node</executable>
              <workingDirectory>${project.basedir}</workingDirectory>
              <arguments>
                <argument>run-smoke.mjs</argument>
              </arguments>
              <timeout>90000</timeout>
            </configuration>
          </execution>
        </executions>
      </plugin>
      <plugin>
        <groupId>org.ngengine</groupId>
        <artifactId>teavm-maven-plugin</artifactId>
        <version>${teavm.version}</version>
        <configuration>
          <mainClass>com.dylibso.chicory.teavm.RuntimeSmoke</mainClass>
          <targetType>JAVASCRIPT</targetType>
          <jsModuleType>ES2015</jsModuleType>
          <targetFileName>runtime-smoke.mjs</targetFileName>
          <minifying>false</minifying>
          <stopOnErrors>true</stopOnErrors>
        </configuration>
        <executions>
          <execution>
            <goals>
              <goal>compile</goal>
            </goals>
          </execution>
        </executions>
      </plugin>
    </plugins>
  </build>
</project>
