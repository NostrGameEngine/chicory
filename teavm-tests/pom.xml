<?xml version="1.0" encoding="UTF-8"?>
<project xmlns="http://maven.apache.org/POM/4.0.0" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 http://maven.apache.org/xsd/maven-4.0.0.xsd">
  <modelVersion>4.0.0</modelVersion>

  <parent>
    <groupId>org.ngengine.chicory</groupId>
    <artifactId>chicory</artifactId>
    <version>999-SNAPSHOT</version>
    <relativePath>../pom.xml</relativePath>
  </parent>
  <artifactId>teavm-tests</artifactId>
  <name>Chicory - NGE TeaVM Runtime Tests</name>
  <description>Run interpreted and precompiled modules in NGE TeaVM JavaScript and Wasm GC</description>

  <properties>
    <!-- Match the fork's ASM dependency within this test module. -->
    <asm.version>9.10.1</asm.version>
    <teavm.version>0.16.0-SNAPSHOT</teavm.version>
    <teavm.backend>javascript</teavm.backend>
    <teavm.targetType>JAVASCRIPT</teavm.targetType>
    <teavm.targetFileName>runtime-smoke.mjs</teavm.targetFileName>
    <maven.deploy.skip>true</maven.deploy.skip>
    <maven.install.skip>true</maven.install.skip>
  </properties>

  <dependencies>
    <dependency>
      <groupId>org.ngengine.chicory</groupId>
      <artifactId>runtime</artifactId>
    </dependency>
    <dependency>
      <groupId>org.ngengine.chicory</groupId>
      <artifactId>wasm</artifactId>
    </dependency>
    <dependency>
      <groupId>org.ngengine</groupId>
      <artifactId>teavm-classlib</artifactId>
      <version>${teavm.version}</version>
      <scope>provided</scope>
    </dependency>
    <dependency>
      <groupId>org.ngengine</groupId>
      <artifactId>teavm-extension-spi</artifactId>
      <version>${teavm.version}</version>
      <scope>provided</scope>
    </dependency>
  </dependencies>

  <repositories>
    <repository>
      <releases>
        <enabled>false</enabled>
      </releases>
      <snapshots>
        <enabled>true</enabled>
      </snapshots>
      <id>nge-teavm-snapshots</id>
      <url>https://central.sonatype.com/repository/maven-snapshots/</url>
    </repository>
  </repositories>
  <pluginRepositories>
    <pluginRepository>
      <releases>
        <enabled>false</enabled>
      </releases>
      <snapshots>
        <enabled>true</enabled>
      </snapshots>
      <id>nge-teavm-snapshots</id>
      <url>https://central.sonatype.com/repository/maven-snapshots/</url>
    </pluginRepository>
  </pluginRepositories>

  <build>
    <plugins>
      <plugin>
        <groupId>org.apache.maven.plugins</groupId>
        <artifactId>maven-dependency-plugin</artifactId>
        <configuration>
          <ignoredUnusedDeclaredDependencies combine.children="append">
            <dependency>org.ngengine:teavm-classlib</dependency>
          </ignoredUnusedDeclaredDependencies>
        </configuration>
      </plugin>
      <plugin>
        <groupId>org.codehaus.mojo</groupId>
        <artifactId>exec-maven-plugin</artifactId>
        <executions>
          <execution>
            <id>execute-javascript</id>
            <goals>
              <goal>exec</goal>
            </goals>
            <phase>integration-test</phase>
            <configuration>
              <executable>node</executable>
              <workingDirectory>${project.basedir}</workingDirectory>
              <arguments>
                <argument>run-smoke.mjs</argument>
                <argument>${teavm.backend}</argument>
              </arguments>
              <timeout>90000</timeout>
            </configuration>
          </execution>
        </executions>
      </plugin>
      <plugin>
        <groupId>org.ngengine</groupId>
        <artifactId>teavm-maven-plugin</artifactId>
        <version>${teavm.version}</version>
        <configuration>
          <mainClass>com.dylibso.chicory.teavm.RuntimeSmoke</mainClass>
          <targetType>${teavm.targetType}</targetType>
          <jsModuleType>ES2015</jsModuleType>
          <targetDirectory>${project.build.directory}/${teavm.backend}</targetDirectory>
          <targetFileName>${teavm.targetFileName}</targetFileName>
          <minifying>false</minifying>
          <stopOnErrors>true</stopOnErrors>
        </configuration>
        <executions>
          <execution>
            <goals>
              <goal>compile</goal>
            </goals>
          </execution>
        </executions>
      </plugin>
      <plugin>
        <groupId>org.ngengine.chicory</groupId>
        <artifactId>chicory-compiler-maven-plugin</artifactId>
        <executions>
          <execution>
            <id>precompile-smoke-module</id>
            <goals>
              <goal>compile</goal>
            </goals>
            <configuration>
              <wasmFile>${project.basedir}/src/main/resources/runtime-smoke.wasm</wasmFile>
              <name>com.dylibso.chicory.teavm.PrecompiledSmoke</name>
            </configuration>
          </execution>
        </executions>
      </plugin>
    </plugins>
  </build>
  <profiles>
    <profile>
      <id>wasm-gc</id>
      <activation>
        <property>
          <name>teavm.backend</name>
          <value>wasm-gc</value>
        </property>
      </activation>
      <properties>
        <teavm.targetType>WEBASSEMBLY_GC</teavm.targetType>
        <teavm.targetFileName>runtime-smoke.wasm</teavm.targetFileName>
      </properties>
      <build>
        <plugins>
          <plugin>
            <groupId>org.codehaus.mojo</groupId>
            <artifactId>exec-maven-plugin</artifactId>
            <executions>
              <execution>
                <id>execute-javascript</id>
                <configuration>
                  <arguments combine.self="override">
                    <argument>--experimental-wasm-exnref</argument>
                    <argument>run-smoke.mjs</argument>
                    <argument>wasm-gc</argument>
                  </arguments>
                </configuration>
              </execution>
            </executions>
          </plugin>
          <plugin>
            <groupId>org.ngengine</groupId>
            <artifactId>teavm-maven-plugin</artifactId>
            <executions>
              <execution>
                <id>copy-wasm-runtime</id>
                <goals>
                  <goal>copy-webassembly-gc-runtime</goal>
                </goals>
                <configuration>
                  <runtimeFileName>wasm-runtime.mjs</runtimeFileName>
                  <modular>true</modular>
                </configuration>
              </execution>
            </executions>
          </plugin>
        </plugins>
      </build>
    </profile>
  </profiles>
</project>
